# PORT: host port mapped to the FrankenPHP container (used by make up).
PORT=8020

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, debug toolbar).
APP_ENV=dev
# APP_DEBUG: enable detailed debug output (`1` in dev, `0` in prod).
APP_DEBUG=1
# FRANKENPHP_MODE: FrankenPHP runtime mode — `worker` (default, long-lived workers) or `classic` (one process per request).
FRANKENPHP_MODE=worker
# APP_SECRET: secret used by Symfony for signing (CSRF tokens, signed URLs). Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> symfony/routing ###
# DEFAULT_URI: base URL used to generate absolute URLs in non-HTTP contexts (CLI commands, mails).
DEFAULT_URI=http://localhost:8020
###< symfony/routing ###

###> nowo-tech/redsys-php ###
# Sandbox credentials from Redsys public docs (override for your terminal).
# Test cards / auth code 123456: see docs/SANDBOX.md
# REDSYS_MERCHANT_CODE: merchant code (FUC) of the Redsys terminal.
REDSYS_MERCHANT_CODE=999008881
# REDSYS_TERMINAL: terminal number of the merchant.
REDSYS_TERMINAL=1
# REDSYS_SECRET_KEY: Base64 SHA-256 secret key of the terminal (public sandbox key; never commit a real one).
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
# REDSYS_ENV: `test` (sandbox SIS) or `live` (production SIS).
REDSYS_ENV=test
###< nowo-tech/redsys-php ###
