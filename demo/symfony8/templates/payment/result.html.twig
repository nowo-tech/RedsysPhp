{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="nowo-ui-card" data-testid="demo-result">
    <div class="nowo-ui-card__header"><h1>{{ title }}</h1></div>
    <div class="nowo-ui-card__body">
      <p>Browser return from Redsys ({{ tone }}). Always verify the online notification signature on <code class="nowo-ui-code">/notify</code> before fulfilling orders.</p>
      <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('home') }}">Back</a>
    </div>
  </div>
{% endblock %}
