{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: title,
        intro: 'Browser return from Redsys (' ~ tone ~ ').',
    }) }}
{% endblock %}

{% block body %}
    {% set _return_title = title %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Browser return', kind: 'detail', testid: 'demo-result'} %}
        {% block section_body %}
            <p>{{ _return_title }}. Always verify the online notification signature on <code class="nowo-ui-code">/notify</code> before fulfilling orders.</p>
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('home') }}">Back</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
