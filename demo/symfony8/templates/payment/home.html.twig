{% extends 'base.html.twig' %}

{% block title %}RedsysPhp demo{% endblock %}

{% block body %}
  <div class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h1>RedsysPhp — redirect demo</h1></div>
    <div class="nowo-ui-card__body">
      <p>Builds a signed auto-submit form to the Redsys SIS (test by default). FrankenPHP worker-safe: HTML is returned as a Response string.</p>
      {{ form_start(form) }}
        {% for child in form %}
          {% if not child.rendered %}{{ form_row(child) }}{% endif %}
        {% endfor %}
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}
